# Google OAuth Client ID for institutional (@usp.br / @icmc.usp.br) login
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Same client ID, read by the server to verify Google tokens (defaults to VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Secret used to sign admin sessions (required in production, min. 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=

# Optional passcode login for offline/VM use (min. 16 chars). Leave empty to disable.
ADMIN_DEV_PASSCODE=

# Optional server-side Gemini API key (defaults to environment/system key)
GEMINI_API_KEY=
